rules_version = '2';

// Cada usuário (dono do salão) só pode ler e escrever os próprios dados.
// O token de acesso do Firebase Auth é validado automaticamente em cada requisição.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcolecao}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
